 void CGameClient::OnRender()
 {
+    // Soft budget: an individual image decode or layer upload cannot be preempted.
+    // Advance during snapshot bootstrap as well as ONLINE, never from worker threads.
+    if(Client()->State() == IClient::STATE_LOADING || Client()->State() == IClient::STATE_ONLINE)
+    {
+        const auto Deadline = time_get_nanoseconds().count() + 2000000;
+        while(time_get_nanoseconds().count() < Deadline)
+        {
+            if(m_MapImages.IsPreparing())
+                m_MapImages.PrepareNext();
+            else if(m_MapLayersBackground.IsPreparing())
+                m_MapLayersBackground.PrepareNext();
+            else if(m_MapLayersForeground.IsPreparing())
+                m_MapLayersForeground.PrepareNext();
+            else
+                break;
+        }
+    }
+
 	const ColorRGBA ClearColor = color_cast<ColorRGBA>(ColorHSLA(g_Config.m_ClOverlayEntities ? g_Config.m_ClBackgroundEntitiesColor : g_Config.m_ClBackgroundColor));
 	Graphics()->Clear(ClearColor.r, ClearColor.g, ClearColor.b);
 
